# ==============================================================================
# AI Video Assistant Environment Variables
# ==============================================================================

# Mistral AI API Key (Required for summarization, information extraction, and RAG chat)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Required for Hinglish audio transcription & translation)
# Get your key at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Whisper STT Model size: tiny | base | small | medium | large (Default: small)
WHISPER_MODEL=small

# Sarvam STT Model (Default: saaras:v2.5)
SARVAM_STT_MODEL=saaras:v2.5
